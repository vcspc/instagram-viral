# Google Gemini API
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# Instagram Credentials
INSTAGRAM_USERNAME=seu_usuario_instagram
INSTAGRAM_PASSWORD=sua_senha_instagram
# Recomendado se o Instagram bloquear login por senha ("upgrade your app"):
# Cookie sessionid obtido no navegador (F12 -> Application -> Cookies -> instagram.com)
INSTAGRAM_SESSIONID=
# Opcional: Chave de 2FA TOTP (se sua conta tiver 2FA configurado com app autenticador)
INSTAGRAM_2FA_SEED=

# Opcional: Proxy (ex: http://user:pass@host:port)
INSTAGRAM_PROXY=

# Configurações de Delays de Segurança (em segundos)
REQUEST_DELAY_MIN=3.0
REQUEST_DELAY_MAX=6.0
MAX_SEARCH_ROUNDS=3

# Diretórios
INSTAGRAM_SESSION_DIR=sessions
OUTPUTS_DIR=outputs
